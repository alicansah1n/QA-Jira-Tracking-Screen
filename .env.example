# Bu dosya yalnızca ŞABLONDUR ve git'e girer — gerçek değer YAZMAYIN.
# Kopyalayın:  copy .env.example .env.local   (macOS/Linux: cp .env.example .env.local)
# ve değerleri .env.local içine girin. Değişiklikten sonra uygulamayı yeniden başlatın.

# Jira Cloud adresi, ör. https://sirketiniz.atlassian.net
JIRA_BASE_URL=
# Jira hesabınızın e-postası
JIRA_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Opsiyonel: uygulama verilerinin klasörü (varsayılan ./data)
# DATA_DIR=./data
