{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "issue": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+-[1-9]\\d*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "issueType": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "key",
        "summary"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "generatedBy": {
      "default": "claude-code",
      "type": "string"
    },
    "summary": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Maddenin ne istediğinin 2-4 cümlelik özeti"
        },
        "changes": {
          "default": [],
          "description": "Yapılan/yapılacak geliştirmeler",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "affectedAreas": {
          "default": [],
          "description": "Etkilenen ekran, servis, modül",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "acceptanceCriteria": {
          "default": [],
          "description": "Madde içinden çıkarılan kabul kriterleri",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "overview"
      ],
      "additionalProperties": false
    },
    "risks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "description",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "default": [],
      "description": "Developer'a ya da analiste sorulması gerekenler",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "environmentNotes": {
      "type": "string",
      "maxLength": 1000
    },
    "testCases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-\\d{2,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "functional",
              "negative",
              "boundary",
              "regression",
              "integration",
              "ui",
              "security",
              "performance"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "preconditions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "description": "Testçinin yapacağı tek bir eylem"
                },
                "expected": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "description": "Bu adımın gözlemlenebilir beklenen sonucu"
                }
              },
              "required": [
                "action",
                "expected"
              ],
              "additionalProperties": false
            }
          },
          "testData": {
            "default": [],
            "description": "Test sırasında kullanılacak somut veriler",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "sourceRefs": {
            "default": [],
            "description": "Bu case'in dayandığı madde içeriği: kısa alıntı ve yeri (ör. 'Açıklama: ...')",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "assumption": {
            "type": "boolean",
            "description": "Madde içeriğine dayanmıyor, varsayıma dayanıyorsa true"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "priority",
          "steps",
          "assumption"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "issue",
    "generatedAt",
    "summary",
    "testCases"
  ],
  "additionalProperties": false
}
